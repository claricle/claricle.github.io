---
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_META } from '../content.config';

interface Props {
  project: CollectionEntry<'projects'>['data'];
}
const { project } = Astro.props;
const meta = CATEGORY_META[project.category];
const tokenClass = `badge-${meta.token}`;
---

<article class:list={['project-card', `cat-${meta.token}`]}>
  <div class:list={['card-stripe', `stripe-${meta.token}`]} aria-hidden="true"></div>
  <div class="card-body">
    <header class="card-header">
      <h3 class="card-title">{project.title}</h3>
      <span class:list={['category-badge', tokenClass]}>{meta.label}</span>
    </header>
    <p class="card-tagline">{project.tagline}</p>
    <p class="card-description">{project.description}</p>
    <div class="card-meta">
      <span class:list={['lang-badge', `lang-${project.language}`]}>{project.language}</span>
    </div>
    <div class="card-links">
      <a href={project.github} target="_blank" rel="noopener" class="link-primary">GitHub</a>
      {project.docs && (
        <a href={project.docs} target="_blank" rel="noopener" class="link-secondary">Docs</a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    background: var(--color-canvas);
    border: 1px solid var(--color-line);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .project-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
  }
  .card-stripe {
    height: 4px;
    width: 100%;
  }
  .stripe-coral  { background: var(--color-spectrum-coral); }
  .stripe-amber  { background: var(--color-spectrum-amber); }
  .stripe-forest { background: var(--color-spectrum-forest); }
  .stripe-sky    { background: var(--color-spectrum-sky); }
  .stripe-plum   { background: var(--color-spectrum-plum); }

  .card-body {
    padding: 1.25rem 1.4rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .card-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .card-tagline {
    margin: 0;
    color: var(--color-ink);
    font-size: 0.95rem;
    font-weight: 500;
  }
  .card-description {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.88rem;
    line-height: 1.55;
    flex: 1;
  }
  .card-meta {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  .lang-badge {
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: var(--color-canvas-soft);
    color: var(--color-ink-muted);
    border: 1px solid var(--color-line);
  }
  .category-badge {
    font-size: 0.72rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-weight: 500;
    white-space: nowrap;
    border: 1px solid currentColor;
  }
  .badge-coral  { color: var(--color-spectrum-coral); }
  .badge-amber  { color: #b8842c; }
  .badge-forest { color: var(--color-spectrum-forest); }
  .badge-sky    { color: var(--color-spectrum-sky); }
  .badge-plum   { color: var(--color-spectrum-plum); }

  :global([data-theme='dark']) .badge-amber,
  :global(.dark) .badge-amber {
    color: var(--color-spectrum-amber);
  }
  @media (prefers-color-scheme: dark) {
    .badge-amber { color: var(--color-spectrum-amber); }
  }

  .card-links {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .link-primary,
  .link-secondary {
    font-size: 0.85rem;
    padding: 0.35rem 0.8rem;
    border-radius: 6px;
    transition: background 0.15s ease;
  }
  .link-primary {
    background: var(--color-ink);
    color: var(--color-canvas);
  }
  .link-secondary {
    background: var(--color-canvas-soft);
    color: var(--color-ink);
    border: 1px solid var(--color-line);
  }
</style>

---
/**
 * RoleGrid — the four roles of the Claricle pipeline.
 *
 * Data mirrors ROLE_META in src/content.config.ts (which is the source of
 * truth); icons are presentation-only here.
 */
interface RoleFeature {
  title: string;
  body: string;
  icon: string;
  token: 'coral' | 'amber' | 'forest' | 'sky';
}

const roles: RoleFeature[] = [
  {
    title: 'Models',
    body: 'Typed domain models that make a format programmable — parse EMF, PostScript, or PDF, walk the model, serialize it back.',
    icon: 'M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3zM12 12l8-4.5M12 12v9M12 12L4 7.5',
    token: 'sky',
  },
  {
    title: 'Lenses',
    body: 'Conformance views over a format — check files against the standards they claim, and repair what deviates.',
    icon: 'M10.5 3a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15zM21 21l-5.2-5.2',
    token: 'coral',
  },
  {
    title: 'Projections',
    body: 'Transform one representation into another — EMF to SVG, PS to SVG, SVG to PNG — with no external binaries.',
    icon: 'M4 12h16M14 6l6 6-6 6',
    token: 'amber',
  },
  {
    title: 'Engines',
    body: 'The shared machinery underneath — layout kernels, PNG codecs, and native parser cores the gems stand on.',
    icon: 'M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z',
    token: 'forest',
  },
];
---

<section class="features">
  <header class="features-head">
    <h2>Four roles, one format pipeline</h2>
    <p>Every library in the suite plays exactly one role. Together they cover the pipeline end to end.</p>
  </header>
  <div class="features-grid">
    {roles.map((role) => (
      <article class:list={['feature-card', `token-${role.token}`]}>
        <div class:list={['feature-icon', `icon-${role.token}`]} aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d={role.icon} />
          </svg>
        </div>
        <h3>{role.title}</h3>
        <p>{role.body}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .features {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }
  .features-head {
    text-align: center;
    margin-bottom: 3rem;
  }
  .features-head h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    margin: 0 0 0.5rem;
    letter-spacing: -0.015em;
  }
  .features-head p {
    color: var(--color-ink-muted);
    margin: 0;
    font-size: 1.05rem;
  }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }
  .feature-card {
    background: var(--color-canvas);
    border: 1px solid var(--color-line);
    border-radius: 14px;
    padding: 1.5rem;
    transition: transform 0.18s ease, border-color 0.18s ease;
  }
  .feature-card:hover { transform: translateY(-2px); }
  .feature-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: white;
    margin-bottom: 0.85rem;
  }
  .feature-icon svg { width: 20px; height: 20px; }
  .icon-coral { background: var(--color-spectrum-coral); }
  .icon-amber { background: var(--color-spectrum-amber); color: #2a2a2a; }
  .icon-forest { background: var(--color-spectrum-forest); }
  .icon-sky { background: var(--color-spectrum-sky); }

  .feature-card h3 {
    margin: 0 0 0.4rem;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .feature-card p {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }
</style>

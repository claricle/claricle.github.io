---
import SpectrumStrip from './SpectrumStrip.astro';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<section class:list={['rainbow-hero', className]}>
  <div class="hero-aura" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-mark">
      <img src="/logo-claricle.svg" alt="Claricle logo" width="96" height="96" />
    </div>
    <p class="hero-eyebrow">An open source project of Ribose</p>
    <h1 class="hero-title">
      Colors give us <span class="rainbow-text">clarity</span>
    </h1>
    <p class="hero-lede">
      Claricle is a family of pure-Ruby libraries for image validation,
      conversion, compression, and vector graphics &mdash; the publication
      pipeline's essential image suite.
    </p>
    <div class="hero-actions">
      <a class="cta-primary" href="/projects/">Explore the ecosystem</a>
      <a class="cta-secondary" href="https://github.com/claricle" target="_blank" rel="noopener">View on GitHub</a>
    </div>

    <div class="hero-spectrum">
      <SpectrumStrip />
    </div>
  </div>
</section>

<style>
  .rainbow-hero {
    position: relative;
    overflow: hidden;
    padding: 6rem 1.5rem 5rem;
    text-align: center;
    isolation: isolate;
  }
  .hero-aura {
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 70%;
    background: radial-gradient(
      ellipse at 50% 100%,
      color-mix(in srgb, var(--color-spectrum-coral) 28%, transparent) 0%,
      color-mix(in srgb, var(--color-spectrum-amber) 22%, transparent) 25%,
      color-mix(in srgb, var(--color-spectrum-forest) 18%, transparent) 50%,
      color-mix(in srgb, var(--color-spectrum-sky) 22%, transparent) 75%,
      color-mix(in srgb, var(--color-spectrum-plum) 16%, transparent) 100%
    );
    filter: blur(40px);
    z-index: -2;
    opacity: 0.7;
  }
  .hero-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 70%,
      color-mix(in srgb, var(--color-canvas) 0%, transparent) 0%,
      var(--color-canvas) 70%
    );
    z-index: -1;
  }
  .hero-inner {
    max-width: 760px;
    margin: 0 auto;
    position: relative;
  }
  .hero-mark img {
    width: 96px;
    height: 96px;
    margin: 0 auto 1.5rem;
    display: block;
    filter: drop-shadow(0 8px 24px rgba(229, 107, 91, 0.18));
  }
  .hero-eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted);
  }
  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.05;
    margin: 0 0 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .hero-lede {
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
    max-width: 620px;
    margin: 0 auto 2rem;
  }
  .hero-actions {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 3rem;
  }
  .cta-primary,
  .cta-secondary {
    display: inline-block;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }
  .cta-primary {
    background: var(--color-ink);
    color: var(--color-canvas);
  }
  .cta-primary:hover { transform: translateY(-1px); }
  .cta-secondary {
    background: transparent;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
  }
  .cta-secondary:hover { border-color: var(--color-ink); }
  .hero-spectrum {
    margin-top: 2rem;
  }
</style>

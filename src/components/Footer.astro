---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="rainbow-border-top footer-stripe" aria-hidden="true"></div>
  <div class="footer-inner">
    <div class="footer-brand">
      <img src="/logo-claricle.svg" alt="" width="28" height="28" />
      <span>Claricle</span>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <a href="/projects/">Projects</a>
      <a href="/about/">About</a>
      <a href="/blog/">Blog</a>
      <a href="https://github.com/claricle" rel="noopener" target="_blank">GitHub</a>
    </nav>
    <p class="footer-meta">
      An open source project of <a href="https://www.ribose.com" rel="noopener" target="_blank">Ribose</a>.
      <br />
      &copy; {year} Ribose Inc. BSD-2-Clause.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    border-top: 1px solid var(--color-line);
    background: var(--color-canvas-soft);
  }
  .footer-stripe {
    height: 4px;
    width: 100%;
  }
  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
  }
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }
  .footer-links {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    justify-content: center;
    font-size: 0.92rem;
  }
  .footer-links a {
    color: var(--color-ink-muted);
    transition: color 0.15s ease;
  }
  .footer-links a:hover { color: var(--color-ink); }
  .footer-meta {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    text-align: right;
    line-height: 1.5;
  }
  .footer-meta a { color: var(--color-ink-muted); text-decoration: underline; text-underline-offset: 2px; }
  .footer-meta a:hover { color: var(--color-ink); }

  @media (max-width: 720px) {
    .footer-inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 1.25rem;
    }
    .footer-brand { justify-content: center; }
    .footer-meta { text-align: center; }
  }
</style>

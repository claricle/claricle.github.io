---
import type { CollectionEntry } from 'astro:content';

type Guide = CollectionEntry<'guides'>['data'];
interface Placeholder {
  format: string;
  description: string;
}

interface Props {
  guide?: Guide;
  placeholder?: Placeholder;
}
const { guide, placeholder } = Astro.props;

const statusLabel: Record<string, string> = {
  stable: 'Stable',
  beta: 'Beta',
  wip: 'Work in progress',
  planned: 'Planned',
};

const isPlaceholder = !!placeholder;
const format = guide?.format ?? placeholder?.format ?? '';
const description = guide?.description ?? placeholder?.description ?? '';
const status = guide?.status ?? 'planned';
const title = guide?.title ?? 'Coming soon';
const url = guide?.url;
---

<article class:list={['guide-card', { placeholder: isPlaceholder }]}>
  <div class="card-head">
    <h3 class="card-format">{format}</h3>
    <span class:list={['status-badge', `status-badge-${status}`]}>
      {statusLabel[status] ?? status}
    </span>
  </div>
  <h2 class="card-title">{title}</h2>
  <p class="card-desc">{description}</p>
  {url ? (
    <a href={url} target="_blank" rel="noopener" class="card-link">
      Read the guide
      <span aria-hidden="true">&rarr;</span>
    </a>
  ) : null}
</article>

<style>
  .guide-card {
    background: var(--color-canvas);
    border: 1px solid var(--color-line);
    border-radius: 14px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .guide-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-ink-muted);
    box-shadow: var(--shadow-card-hover);
  }
  .guide-card.placeholder {
    background: var(--color-canvas-soft);
    border-style: dashed;
  }
  .guide-card.placeholder:hover {
    transform: none;
    box-shadow: none;
    border-color: var(--color-ink-muted);
  }
  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }
  .card-format {
    margin: 0;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-muted);
    font-weight: 600;
  }
  .status-badge {
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid currentColor;
    white-space: nowrap;
  }
  .status-badge-stable  { color: var(--color-spectrum-forest); }
  .status-badge-beta    { color: var(--color-spectrum-sky); }
  .status-badge-wip     { color: var(--color-spectrum-amber); }
  .status-badge-planned { color: var(--color-ink-muted); }

  .card-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .card-desc {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.92rem;
    line-height: 1.55;
    flex: 1;
  }
  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-ink);
    margin-top: 0.5rem;
    transition: gap 0.15s ease;
  }
  .card-link:hover { gap: 0.6rem; }
</style>

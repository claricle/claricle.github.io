---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Blog — Claricle"
  description="Notes, releases, and deep dives from the Claricle project."
>
  <header class="page-hero">
    <p class="eyebrow">Blog</p>
    <h1>Notes from the suite</h1>
    <p class="lede">
      Release notes, deep dives into image formats, and the occasional rant
      about EPS. Watch this space.
    </p>
  </header>

  <section class="container">
    {posts.length === 0 ? (
      <div class="empty-state">
        <div class="empty-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <path d="M3 7h18M3 12h18M3 17h12" />
          </svg>
        </div>
        <h2>No posts yet</h2>
        <p>The first one is coming. Star <a href="https://github.com/claricle" target="_blank" rel="noopener">the org on GitHub</a> to know when.</p>
      </div>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="post-card">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <span class="author">{post.data.author}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding: 4rem 1.5rem 2rem;
    background: var(--color-canvas-soft);
    border-bottom: 1px solid var(--color-line);
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.78rem;
    color: var(--color-ink-muted);
    margin: 0 0 0.5rem;
  }
  .page-hero h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.02em;
  }
  .lede {
    color: var(--color-ink-muted);
    max-width: 580px;
    margin: 0 auto;
  }
  .container {
    max-width: 760px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }
  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
  }
  .empty-mark {
    width: 56px;
    height: 56px;
    margin: 0 auto 1rem;
    border-radius: 16px;
    background: var(--color-canvas-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink-muted);
  }
  .empty-mark svg { width: 28px; height: 28px; }
  .empty-state h2 {
    margin: 0 0 0.5rem;
  }
  .empty-state p {
    color: var(--color-ink-muted);
    margin: 0;
  }
  .empty-state a { color: var(--color-ink); text-decoration: underline; text-underline-offset: 2px; }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .post-card {
    display: block;
    padding: 1.25rem 1.5rem;
    background: var(--color-canvas);
    border: 1px solid var(--color-line);
    border-radius: 12px;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .post-card:hover { transform: translateY(-2px); border-color: var(--color-ink-muted); }
  .post-card time {
    font-size: 0.8rem;
    color: var(--color-ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .post-card h2 {
    margin: 0.4rem 0 0.3rem;
    font-size: 1.25rem;
  }
  .post-card p {
    margin: 0 0 0.5rem;
    color: var(--color-ink-muted);
    font-size: 0.95rem;
  }
  .author { font-size: 0.82rem; color: var(--color-ink-muted); }
</style>

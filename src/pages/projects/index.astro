---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import ProjectsGrid from '../../components/ProjectsGrid.astro';
import SpectrumStrip from '../../components/SpectrumStrip.astro';

const projects = await getCollection('projects');
---

<BaseLayout
  title="Projects — Claricle"
  description="The Claricle ecosystem, grouped by role: models, lenses, projections, and engines for image formats."
>
  <header class="page-hero">
    <div class="page-hero-inner">
      <p class="eyebrow">The ecosystem</p>
      <h1>Models, lenses, and projections for image formats</h1>
      <p class="lede">
        Grouped by the role each library plays. Every project is open source
        under the <a href="https://github.com/claricle" target="_blank" rel="noopener">claricle</a> org on GitHub; gems link to
        their pages on RubyGems.
      </p>
      <div class="spectrum-row">
        <SpectrumStrip />
      </div>
    </div>
  </header>

  <section class="container">
    <ProjectsGrid projects={projects} filterable={true} grouped={true} />
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: var(--color-canvas-soft);
    border-bottom: 1px solid var(--color-line);
    padding: 4rem 1.5rem 3rem;
  }
  .page-hero-inner {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.78rem;
    color: var(--color-ink-muted);
    margin: 0 0 0.5rem;
  }
  .page-hero h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.02em;
  }
  .lede {
    color: var(--color-ink-muted);
    font-size: 1.1rem;
    line-height: 1.55;
    margin: 0 auto 1.5rem;
    max-width: 580px;
  }
  .lede a { color: var(--color-ink); text-decoration: underline; text-underline-offset: 2px; }
  .spectrum-row {
    max-width: 800px;
    margin: 1.5rem auto 0;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }
</style>
